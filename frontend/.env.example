# Frontend — Vercel + local dev
# Copy to .env for local: cp .env.example .env

# Local dev: Vite proxies /api → http://localhost:5000 (see vite.config.js)
VITE_API_URL=/api

# Production (set in Vercel Dashboard → Settings → Environment Variables):
# VITE_API_URL=https://khairatabad-ganesh-api.onrender.com/api

# Optional: override where Vite proxy points in local dev
# VITE_PROXY_TARGET=http://localhost:5000
