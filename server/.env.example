# Server — Render + local dev
# Copy to .env for local: cp .env.example .env
# On Render: set these in Dashboard → Environment (PORT is auto-injected)

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/ganesh_chaturthi
# Atlas for production:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ganesh_chaturthi?retryWrites=true&w=majority

JWT_SECRET=replace_with_super_secret_min_32_chars
ADMIN_EMAIL=admin@ganeshutsav.com
ADMIN_PASSWORD=Admin@123

# CORS — must match your Vercel URL in production
FRONTEND_URL=http://localhost:5173
# For previews / extra domains (comma-separated):
# ALLOWED_ORIGINS=https://your-app.vercel.app
